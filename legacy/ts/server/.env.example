# Copy to `.env` and change values.

# REQUIRED: secret used for issuing/verifying WebSocket JWT tokens.
# Must be a real random string of at least 32 bytes. Generate one with:
#   openssl rand -hex 32
# Left empty on purpose — the server refuses to start until a real value is set
# (placeholders and low-entropy values are rejected at startup).
WS_JWT_SECRET=

# OPTIONAL
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Number of trusted proxy hops in front of this server. This decides which
# X-Forwarded-For entry every rate limiter buckets on, so it must match the real
# deployment — both mistakes are silent:
#   too high, and a caller picks their own bucket by sending the header, so no
#            limit ever fires;
#   too low,  and every caller in the world shares one bucket.
#   0  direct, no proxy (local development)
#   1  one proxy — Render alone, the current production shape
#   2  two proxies — Cloudflare in front of Render
# `true`/`false` are still accepted and mean 1/0.
TRUST_PROXY=0
# Comma-separated allowlist. Example:
# CLIENT_ORIGIN=https://lume.example.com,https://www.lume.example.com
CLIENT_ORIGIN=http://localhost:3000
# Max JSON request body size. Default 8mb so base64-encoded file uploads fit (files capped at 5 MB raw).
JSON_LIMIT=8mb
WS_MAX_PAYLOAD_BYTES=65536
# Concurrent WebSocket sockets held from one address. Generous on purpose:
# carrier NAT, VPNs and Tor put many legitimate users on one address, and a
# tight cap locks them out rather than stopping an attacker.
WS_MAX_CONNECTIONS_PER_IP=128
# Concurrent sockets for the whole process. This is the ceiling that actually
# bounds memory and event-loop pressure, whatever the load's shape.
WS_MAX_CONNECTIONS_TOTAL=5000

# Socket deadlines, in milliseconds.
# Headers are small, so a caller that cannot finish them in time is holding the
# socket open deliberately — this is the slow-loris control.
HEADERS_TIMEOUT_MS=20000
# The body may legitimately be large: a 5 MB attachment is ~6.7 MB base64 over
# the wire, which is close to two minutes on a poor mobile uplink. Tightening
# this looks like hardening and silently breaks sending a photo on a train.
REQUEST_TIMEOUT_MS=120000

# Accounts untouched for this long are deleted and their usernames released.
# Irreversible, so the default is deliberately long — a year of total silence is
# unambiguous, and a shorter number chosen before there is usage data would be a
# guess enforced by deletion. The server refuses to boot below 30.
INACTIVE_USER_MAX_AGE_DAYS=365
# Accounts reclaimed per pass. Bounded so a sweep never holds a write
# transaction over the whole table while the server takes live traffic.
INACTIVE_USER_BATCH=200

# Set to 1 to enable per-request logging (noisy in production).
LOG_HTTP=0
# Set to 1 to enable security-related logs (audit/debug).
LOG_SECURITY=0

# Legacy: the WebSocket path alone used to read this. Both paths now share
# TRUST_PROXY above; this is still honoured so an existing deployment that sets
# only this one does not silently lose proxy trust.
WS_TRUST_PROXY=0

# Development only: force-close WS connections with a specific close code.
# WS_DEV_FORCE_CLOSE_CODE=

# Required in production to expose GET /api/metrics. If unset, metrics is disabled (403) in production.
# METRICS_SECRET=generate-a-long-random-string

# Web Push (VAPID). Optional — only needed if push notifications are enabled.
# Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Optional explicit DB path (default resolves to ./data/messenger.db).
# DB_PATH=/app/data/messenger.db
