# LUME monorepo — local / generated only (safe to clone on any OS)

# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
*.tsbuildinfo

# Environment & secrets (never commit)
.env
.env.local
.env.*.local
.env.production
!.env*.example
!.env.docker.example

# Local database & uploaded blobs
data/
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/uploads/

# Test artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo

# IDE / editor
.vscode/
.idea/
*.sublime-*

# Generated by brand/export-pdf.mjs — rebuilt from the HTML, not edited by hand.
brand/*.pdf
