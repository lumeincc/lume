{
  "name": "lume-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "LUME mobile (React Native / Expo). The crypto core is vendored verbatim from the web client and shares identical test vectors to guard against drift; platform-specific pieces (KDF, storage, secure keystore) live behind an adapter.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "audit:gate": "node scripts/audit-gate.mjs",
    "test:watch": "vitest",
    "sim:build": "esbuild scripts/device-sim.ts --bundle --platform=node --format=esm --main-fields=react-native,browser,module,main --conditions=react-native,browser,import --outfile=.tmp/device-sim.mjs --log-level=warning",
    "sim": "npm run sim:build && node .tmp/device-sim.mjs",
    "sim:negative": "npm run sim:build && node .tmp/device-sim.mjs --no-polyfills",
    "verify": "npm test && npm run sim && npm run sim:negative && expo export -p android --output-dir .tmp/export",
    "relay:check": "esbuild scripts/relay-check.ts --bundle --platform=node --format=cjs --outfile=.tmp/relay-check.cjs --log-level=warning && node .tmp/relay-check.cjs",
    "e2e:message": "esbuild scripts/e2e-message.ts --bundle --platform=node --format=cjs --outfile=.tmp/e2e-message.cjs --log-level=warning && node .tmp/e2e-message.cjs",
    "e2e:realtime": "esbuild scripts/e2e-realtime.ts --bundle --platform=node --format=cjs --external:ws --outfile=.tmp/e2e-realtime.cjs --log-level=warning && node .tmp/e2e-realtime.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@noble/hashes": "^2.2.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8",
    "esbuild": "$esbuild",
    "postcss": "^8.5.23",
    "uuid": "^11.1.1",
    "js-yaml": "^4.1.1",
    "nanoid": "^3.3.18"
  }
}
